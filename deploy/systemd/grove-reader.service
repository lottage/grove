[Unit]
Description=Grove reader (read-only web text for the residents)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grovereader
Group=grovereader
WorkingDirectory=/
EnvironmentFile=/etc/grove/reader.env
ExecStart=/opt/grove/venv/bin/python -m grove.reader
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=512M

[Install]
WantedBy=multi-user.target
